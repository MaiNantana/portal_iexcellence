# Production .env for the Portal server (copy to .env next to package.json; never commit it).

# Database: own user + own database on the shared MariaDB (deploy/mariadb-setup.prod.sql)
DATABASE_URL="mysql://portal:<STRONG_PASSWORD>@hr.iexcellence.cloud:3307/portal"
# Only used by `prisma migrate dev`, which must never run in production — keep it unreachable on purpose.
SHADOW_DATABASE_URL="mysql://unused:unused@127.0.0.1:1/unused"

# Auth.js — generate AUTH_SECRET with: npx auth secret   (changing it later invalidates sessions
# and the encrypted Task API keys, which then must be re-entered)
AUTH_URL="https://portal.iexcellence.cloud"
AUTH_TRUST_HOST="true"
AUTH_SECRET=""

# Sign-in handoff to HR / Task — generate with: node scripts/gen-signing-key.mjs (a NEW key, not the dev one)
PORTAL_SIGNING_KID=""
PORTAL_SIGNING_KEY=""

# Email (OTP + invitations) via Amazon SES. Use a dedicated IAM user allowed only ses:SendEmail /
# ses:SendRawEmail; MAIL_FROM must be an SES-verified identity.
MAIL_TRANSPORT="ses"
AWS_REGION="ap-southeast-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
MAIL_FROM="iExcellence Workspace <no-reply@iexcellence.cloud>"

# Optional: Google / Microsoft sign-in (buttons appear only when set)
# Redirect URIs: https://portal.iexcellence.cloud/api/auth/callback/google
#                https://portal.iexcellence.cloud/api/auth/callback/microsoft-entra-id
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"
