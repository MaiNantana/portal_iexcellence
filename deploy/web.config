<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS site "portal" (portal.iexcellence.cloud), hosted with iisnode like the Task API.
     Every request goes to server.js (Next.js serves its own assets), so files such as .env or
     node_modules are never served directly. -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" responseBufferLimit="0" />
    </handlers>
    <iisnode node_env="production"
             nodeProcessCommandLine="&quot;C:\Program Files\nodejs\node.exe&quot;"
             promoteServerVars="HTTPS"
             enableXFF="true"
             flushResponse="true"
             loggingEnabled="true"
             devErrorsEnabled="false"
             watchedFiles="web.config;server.js;.env" />
    <rewrite>
      <rules>
        <rule name="Next.js" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
    <httpErrors existingResponse="PassThrough" />
    <security>
      <!-- Next.js asset paths contain [slug] and encoded characters. -->
      <requestFiltering allowDoubleEscaping="true">
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="iisnode" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
