# MariaDB 10.2+ (see scripts/mariadb-setup.sql)
DATABASE_URL="mysql://portal:CHANGE_ME@127.0.0.1:3307/portal"
SHADOW_DATABASE_URL="mysql://portal:CHANGE_ME@127.0.0.1:3307/portal_shadow"

# Auth.js (generate a real secret for any shared environment: npx auth secret)
AUTH_SECRET="dev-only-secret-change-me-0123456789abcdef"
AUTH_URL="http://localhost:3000"

# Google (https://console.cloud.google.com/apis/credentials) — redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Microsoft Entra ID (multi-tenant app registration) — redirect URI: {AUTH_URL}/api/auth/callback/microsoft-entra-id
# Required: add the optional ID-token claim "xms_edov" (verified email); sign-ins without it are rejected.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"

# SMTP for OTP and invitation emails. Leave SMTP_HOST empty in dev to print emails to the console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="iExcellence Workspace <no-reply@example.com>"

# Signs HR / Task sign-in handoff tokens (generate: node scripts/gen-signing-key.mjs)
PORTAL_SIGNING_KID=""
PORTAL_SIGNING_KEY=""

# TaskExcellence (shared by every company; defaults to production). For a local Task:
# TASK_BASE_URL="http://localhost:3000/"
# TASK_API_URL="http://localhost:8080"
